@@ -208,6 +209,67 @@ void Presenter::ViSwap(u32 xfb_addr, u32 fb_width, u32 fb_stride, u32 fb_height,
 
   auto& video_events = GetVideoEvents();
 
+  // Frame interpolation. Each video field is split into M presents (M = 1 for 60 fps output,
+  // 2 for 120). A game frame lasting D fields gets D*M - 1 in-between frames rendered at
