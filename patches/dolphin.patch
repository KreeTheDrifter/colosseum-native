+void Presenter::PresentInterpolated(const RcTcacheEntry& entry, u32 fb_width, u32 fb_height,
+                                    u64 ticks, TimePoint when)
+{
+  if (entry->native_width == 0 || entry->native_height == 0)
+    return;
+  RcTcacheEntry real_entry = m_xfb_entry;
+  const MathUtil::Rectangle<int> real_rect = m_xfb_rect;
+  if (entry != real_entry)
+  {
+    m_xfb_entry = entry;
+    m_xfb_rect = MathUtil::Rectangle<int>(
+        0, 0, static_cast<int>(fb_width * entry->GetWidth() / entry->native_width),
+        static_cast<int>(fb_height * entry->GetHeight() / entry->native_height));
+  }
+
+  PresentInfo info{
+      .frame_count = m_frame_count > 0 ? m_frame_count - 1 : 0,
+      .present_count = m_present_count++,
+      .reason = PresentInfo::PresentReason::VideoInterfaceDuplicate,
+      .emulated_timestamp = ticks,
+      .intended_present_time = when,
+  };
+  Present(&info);
+  GetVideoEvents().after_present_event.Trigger(info);
+
+  m_xfb_entry = std::move(real_entry);
+  m_xfb_rect = real_rect;
+}
