+RcTcacheEntry TextureCacheBase::CopyXFBToPrivateEntry(
+    u32 width, u32 height, u32 dstStride, const MathUtil::Rectangle<int>& srcRect, float y_scale,
+    float gamma, bool clamp_top, bool clamp_bottom,
+    const CopyFilterCoefficients::Values& filter_coefficients)
+{
+  if (!g_backend_info.bSupportsCopyToVram || g_ActiveConfig.bDisableCopyToVRAM)
+    return {};
+
+  // Mirrors the copy_to_vram path of CopyRenderTargetToTexture for XFB copies.
+  const u32 scaled_tex_w = g_framebuffer_manager->EFBToScaledX(width);
+  const u32 scaled_tex_h = g_framebuffer_manager->EFBToScaledY(height);
+  const bool linear_filter = g_framebuffer_manager->GetEFBScale() != 1 || y_scale > 1.0f;
+  const TextureConfig config(scaled_tex_w, scaled_tex_h, 1, g_framebuffer_manager->GetEFBLayers(),
+                             1, AbstractTextureFormat::RGBA8, AbstractTextureFlag_RenderTarget,
+                             AbstractTextureType::Texture_2DArray);
+  RcTcacheEntry entry = AllocateCacheEntry(config);
+  if (!entry)
+    return {};
+
+  const TextureFormat base_format = TexDecoder_GetEFBCopyBaseFormat(EFBCopyFormat::XFB);
+  entry->SetGeneralParameters(0, 0, base_format, true);
+  entry->SetDimensions(width, height, 1);
+  entry->frameCount = FRAMECOUNT_INVALID;
+  entry->SetXfbCopy(std::max(dstStride, entry->BytesPerRow()));
+  entry->may_have_overlapping_textures = false;
+  entry->is_custom_tex = false;
+  CopyEFBToCacheEntry(entry, false, srcRect, false, linear_filter, EFBCopyFormat::XFB, false, gamma,
+                      clamp_top, clamp_bottom, GetVRAMCopyFilterCoefficients(filter_coefficients));
+  return entry;
+}
