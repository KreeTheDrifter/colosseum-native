+
+namespace FrameInterpolation
+{
+bool g_recording = false;
+bool g_hook = false;
+bool g_replaying = false;
+
+namespace
+{
+std::atomic<bool> s_want_enabled{false};
+
+// One XF write (immediate or indexed) in recording order.
+struct XFEvent
+{
+  u16 address;
+  u8 count;        // 0: indexed load that couldn't be read; replays as a no-op
+  u32 offset;      // into the frame's value pool (big-endian words, as on the wire)
+  u64 signature;   // the first draw after this write
+  u64 loose;       // the same without vertex count and vertex array address
+};
+
+// BP TEV colour registers (fades, flashes, tints) travel as events too, at this pseudo
+// address + register.
+constexpr u16 BP_EVENT_BASE = 0x2000;
+constexpr u8 BP_TEV_COLOR_FIRST = 0xE0;  // BPMEM_TEV_COLOR_RA / _BG, four pairs
+constexpr u8 BP_TEV_COLOR_LAST = 0xE7;
+bool IsBPColorEvent(u16 address)
+{
+  return address >= BP_EVENT_BASE + BP_TEV_COLOR_FIRST && address <= BP_EVENT_BASE + BP_TEV_COLOR_LAST;
+}
+
+// A draw with vertex positions or colours inline in the command stream (2D, particles,
+// CPU-animated meshes). Those are blended per vertex against the same draw last frame.
+struct Draw
+{
+  u64 key;
+  u32 data_offset;  // vertex data in Frame::commands
+  u16 count;
+  u16 vertex_size;
+  s16 pos_offset = -1;  // -1: positions not inline
+  u8 pos_format = 0;
+  u8 pos_components = 0;
+  s16 col_offset[2] = {-1, -1};  // only 8-bit-per-channel formats
+  u8 col_bytes[2] = {0, 0};
+  s32 partner = -1;  // draw in the previous frame
+};
+
+struct Frame
+{
+  std::vector<u8> commands;
+  std::vector<XFEvent> events;
+  std::vector<u32> values;
+  std::vector<Draw> draws;
+  std::vector<u8> tluts;  // palette loads, in order
+  size_t unsigned_from = 0;  // events still waiting for a draw signature
+
+  void Clear()
+  {
+    commands.clear();
+    events.clear();
+    values.clear();
+    draws.clear();
+    tluts.clear();
+    unsigned_from = 0;
+  }
+};
+
+Frame s_cur;
+Frame s_prev;
+bool s_have_prev = false;
+bool s_frame_end_pending = false;
+u32 s_pending_xfb_addr = 0;
+
+std::vector<u8> s_start_state;  // GPU state when s_cur began
+std::vector<u8> s_live_state;   // scratch
+bool s_have_start = false;
+
+std::vector<u32> s_interp_values;  // per s_cur.values, blended
+float s_t = 0.5f;
+size_t s_tlut_read = 0;
+float s_t_override = -1.0f;  // COLO_INTERP_T (debug)
+std::atomic<int> s_presents_per_field{2};
+int s_fields_per_frame = 1;  // how long the last game frame stayed on screen, in fields
+bool s_log = false;
+bool s_debug_frame = false;
+
+std::shared_ptr<TCacheEntry> s_replay_result;
+// Finished in-between frames, by the XFB address of the real frame they precede. The video
+// interface usually shows an XFB one frame after it was drawn (the game renders the next frame
+// into the other buffer meanwhile), so more than one can be waiting.
+struct Ready
+{
+  u32 addr = 0;
+  std::vector<std::shared_ptr<TCacheEntry>> entries;
+};
+std::array<Ready, 4> s_ready;
+u32 s_ready_seq = 0;
+
+void DropReady(u32 addr)
+{
+  for (Ready& r : s_ready)
+  {
+    if (r.addr == addr)
+      r.entries.clear();
+  }
+}
+
+// Statistics (s_log).
+u32 s_stat_frames = 0, s_stat_replayed = 0, s_stat_cuts = 0;
+u64 s_stat_events = 0, s_stat_matched = 0;
+double s_stat_ms = 0;
+
+u64 Mix(u64 h, u64 v)
+{
+  h ^= v + 0x9e3779b97f4a7c15ULL + (h << 6) + (h >> 2);
+  return h;
+}
+
+void DoGpuState(PointerWrap& p)
+{
+  auto& system = Core::System::GetInstance();
+  p.Do(bpmem);
+  p.Do(g_main_cp_state);
+  p.Do(xfmem);
+  p.DoArray(s_tex_mem);
+  TMEM::DoState(p);
+  system.GetPixelShaderManager().DoState(p);
+  system.GetVertexShaderManager().DoState(p);
+  system.GetGeometryShaderManager().DoState(p);
+  g_vertex_manager->DoState(p);
+  system.GetXFStateManager().DoState(p);
+  if (p.IsReadMode())
+  {
+    BPReload();
+    VertexLoaderManager::MarkAllDirty();
+  }
+}
+
+void SaveGpuState(std::vector<u8>& buf)
+{
+  if (buf.empty())
+    buf.resize(2 * 1024 * 1024);
+  for (;;)
+  {
+    u8* ptr = buf.data();
+    PointerWrap p(&ptr, buf.size(), PointerWrap::Mode::Write);
+    DoGpuState(p);
+    const size_t used = p.GetOffsetFromPreviousPosition(buf.data());
+    if (p.IsWriteMode())
+      return;
+    buf.resize(used + 4096);
+  }
+}
+
+void LoadGpuState(std::vector<u8>& buf)
+{
+  u8* ptr = buf.data();
+  PointerWrap p(&ptr, buf.size(), PointerWrap::Mode::Read);
+  DoGpuState(p);
+}
+
+float F(u32 big_endian)
+{
+  return std::bit_cast<float>(Common::swap32(big_endian));
+}
+u32 BE(float f)
+{
+  return Common::swap32(std::bit_cast<u32>(f));
+}
+
+bool Finite(float f)
+{
+  return std::isfinite(f);
+}
+
+float ReadComponent(const u8* p, u8 format)
+{
+  switch (format)
+  {
+  case 0: return float(p[0]);
+  case 1: return float(s8(p[0]));
+  case 2: return float(Common::swap16(p));
+  case 3: return float(s16(Common::swap16(p)));
+  default: return std::bit_cast<float>(Common::swap32(p));
+  }
+}
+u32 ComponentSize(u8 format)
+{
+  return format <= 1 ? 1 : format <= 3 ? 2 : 4;
+}
+
+// Largest per-vertex position change between two versions of a draw; infinity if they
+// can't be compared.
+float DrawMove(const Draw& d, const Draw& p)
+{
+  constexpr float inf = std::numeric_limits<float>::infinity();
+  if (p.count != d.count || p.vertex_size != d.vertex_size || d.pos_offset < 0 ||
+      p.data_offset + size_t(p.count) * p.vertex_size > s_prev.commands.size() ||
+      d.data_offset + size_t(d.count) * d.vertex_size > s_cur.commands.size())
+    return inf;
+  const u8* a = &s_prev.commands[p.data_offset];
+  const u8* b = &s_cur.commands[d.data_offset];
+  const u32 cs = ComponentSize(d.pos_format);
+  float max_move = 0;
+  for (u32 v = 0; v < d.count; ++v)
+  {
+    for (u32 c = 0; c < d.pos_components; ++c)
+    {
+      const u32 at = v * d.vertex_size + d.pos_offset + c * cs;
+      const float m = std::fabs(ReadComponent(b + at, d.pos_format) - ReadComponent(a + at, d.pos_format));
+      if (!std::isfinite(m))
+        return inf;
+      max_move = std::max(max_move, m);
+    }
+  }
+  return max_move;
+}
+
+// How different two loads of the same registers are (sum of absolute value differences).
+bool IsColorEvent(const XFEvent& e)
+{
+  return IsBPColorEvent(e.address) ||
+         (e.address <= XFMEM_SETCHAN1_MATCOLOR && e.address + e.count > XFMEM_SETCHAN0_AMBCOLOR);
+}
+
+float EventDistance(const XFEvent& e, const XFEvent& p)
+{
+  float sum = 0;
+  for (u32 i = 0; i < e.count; ++i)
+  {
+    const u32 a = s_cur.values[e.offset + i], b = s_prev.values[p.offset + i];
+    if (a == b)
+      continue;
+    if (IsColorEvent(e))
+    {
+      // Colours: per-byte difference (the words aren't floats).
+      for (int sh = 0; sh < 32; sh += 8)
+        sum += std::abs(int((a >> sh) & 0xff) - int((b >> sh) & 0xff));
+      continue;
+    }
+    const float d = std::fabs(F(a) - F(b));
+    sum += std::isfinite(d) ? d : 1e30f;
+  }
+  return sum;
+}
+
+// Rows of a 3x4 (stride 4) or 3x3 (stride 3) matrix rotated by more than ~60 degrees between the
+// two frames: almost certainly a mismatched object, or a cut.
+bool RotationJump(const u32* a, const u32* b, int stride)
+{
+  for (int r = 0; r < 3; ++r)
+  {
+    float dot = 0, la = 0, lb = 0;
+    for (int c = 0; c < 3; ++c)
+    {
+      const float x = F(a[r * stride + c]), y = F(b[r * stride + c]);
+      dot += x * y;
+      la += x * x;
+      lb += y * y;
+    }
+    if (la < 1e-12f || lb < 1e-12f)
+      continue;
+    if (dot < 0.5f * std::sqrt(la * lb))
+      return true;
+  }
+  return false;
+}
+
+// Blends event `e` of s_cur against `p` of s_prev into s_interp_values. Returns true if any
+// value was interpolated.
+// Translation of a 3x4 matrix moved by more than 15% of its distance from the eye: not the
+// same object (used for loosely matched loads only).
+bool TranslationJump(const u32* a, const u32* b)
+{
+  float d2 = 0, na = 0, nb = 0;
+  for (int r = 0; r < 3; ++r)
+  {
+    const float x = F(a[r * 4 + 3]), y = F(b[r * 4 + 3]);
+    d2 += (x - y) * (x - y);
+    na += x * x;
+    nb += y * y;
+  }
+  const float limit = 0.15f * std::sqrt(std::max(na, nb)) + 1e-3f;
+  return d2 > limit * limit;
+}
+
+bool Blend(const XFEvent& e, const XFEvent& p, bool loose)
+{
+  const u32* a = &s_prev.values[p.offset];
+  const u32* b = &s_cur.values[e.offset];
+  u32* out = &s_interp_values[e.offset];
+  const u32 base = e.address;
+  const u32 n = e.count;
+
+  // Whole-matrix guards.
+  bool reject = false;
+  if (base < XFMEM_POSMATRICES_END || (base >= XFMEM_POSTMATRICES && base < XFMEM_POSTMATRICES_END))
+  {
+    for (u32 m = 0; m + 12 <= n && !reject; m += 12)
+      reject = RotationJump(a + m, b + m, 4) || (loose && TranslationJump(a + m, b + m));
+  }
+  else if (base >= XFMEM_NORMALMATRICES && base < XFMEM_NORMALMATRICES_END)
+  {
+    for (u32 m = 0; m + 9 <= n && !reject; m += 9)
+      reject = RotationJump(a + m, b + m, 3);
+  }
+  if (reject)
+    return false;
+
+  // Projection: only between two projections of the same kind.
+  bool projection_ok = true;
+  if (base <= XFMEM_SETPROJECTION + 6 && base + n > XFMEM_SETPROJECTION + 6)
+  {
+    const u32 i = XFMEM_SETPROJECTION + 6 - base;
+    projection_ok = a[i] == b[i];
+  }
+
+  bool any = false;
+  for (u32 i = 0; i < n; ++i)
+  {
+    const u32 addr = base + i;
+    bool lerp = false;
+    bool texture_translation = false;
+    if (addr < XFMEM_POSMATRICES_END)
+    {
+      lerp = true;
+      // Texture matrices (GX_TEXMTX0 = 30, i.e. word 120 onward): don't slide back across a
+      // scrolling texture's wrap-around.
+      texture_translation = addr >= 120 && (addr & 3) == 3;
+      // Texture matrices (word 120 on) stay as in frame N: games animate them with jumps
+      // (Phenac's red dome lost its colour when they were blended).
+      if (addr >= 120)
+        lerp = false;
+    }
+    else if (addr >= XFMEM_NORMALMATRICES && addr < XFMEM_NORMALMATRICES_END)
+    {
+      lerp = true;
+    }
+    else if (addr >= XFMEM_POSTMATRICES && addr < XFMEM_POSTMATRICES_END)
+    {
+      lerp = true;
+      texture_translation = (addr & 3) == 3;
+      lerp = false;  // texture post-matrices: see above
+    }
+    else if (addr >= XFMEM_LIGHTS && addr < XFMEM_LIGHTS_END)
+    {
+      // Light: 3 reserved, colour, cos att x3, dist att x3, position x3, direction x3.
+      lerp = ((addr - XFMEM_LIGHTS) & 15) >= 10;
+    }
+    else if (addr >= XFMEM_SETPROJECTION && addr < XFMEM_SETPROJECTION + 6)
+    {
+      lerp = projection_ok;
+    }
+
+    if (IsBPColorEvent(static_cast<u16>(addr)))
+    {
+      // 11-bit signed R/A (or B/G) fields at bits 0 and 12; bit 23 selects konst colour.
+      const u32 ra = Common::swap32(a[i]), rb = Common::swap32(b[i]);
+      if (ra == rb || ((ra ^ rb) & (1u << 23)))
+        continue;
+      u32 v = rb;
+      for (int sh : {0, 12})
+      {
+        const s32 x = s32((ra >> sh) & 0x7ff) << 21 >> 21, y = s32((rb >> sh) & 0x7ff) << 21 >> 21;
+        const s32 m = static_cast<s32>(std::lround(x + (y - x) * s_t));
+        v = (v & ~(0x7ffu << sh)) | ((u32(m) & 0x7ff) << sh);
+      }
+      out[i] = Common::swap32(v);
+      any = true;
+      continue;
+    }
+    // Ambient / material colours are left as in frame N: blending them broke translucent
+    // objects (Phenac's red dome turned clear); fades come through the BP colours above.
+    if (false && addr >= XFMEM_SETCHAN0_AMBCOLOR && addr <= XFMEM_SETCHAN1_MATCOLOR && a[i] != b[i])
+    {
+      // Ambient / material colours (RGBA8): fades and flashes.
+      const u32 ca = Common::swap32(a[i]), cb = Common::swap32(b[i]);
+      u32 c = 0;
+      for (int sh = 0; sh < 32; sh += 8)
+      {
+        const float x = float((ca >> sh) & 0xff), y = float((cb >> sh) & 0xff);
+        c |= u32(std::clamp(std::lround(x + (y - x) * s_t), 0L, 255L)) << sh;
+      }
+      out[i] = Common::swap32(c);
+      if (static int dbg = std::getenv("COLO_INTERP_DBGCOL") ? 60 : 0; dbg > 0)
+      {
+        --dbg;
+        std::fprintf(stderr, "[interp] colour addr=%03x prev=%08x cur=%08x out=%08x sig=%016llx\n",
+                     addr, ca, cb, c, static_cast<unsigned long long>(e.signature));
+      }
+      any = true;
+      continue;
+    }
+    if (!lerp || a[i] == b[i])
+      continue;
+    const float fa = F(a[i]), fb = F(b[i]);
+    if (!Finite(fa) || !Finite(fb))
+      continue;
+    if (texture_translation && std::fabs(fb - fa) > 0.3f)
+      continue;
+    out[i] = BE(fa + (fb - fa) * s_t);
+    any = true;
+  }
+  return any;
+}
+
+// Fills s_interp_values. Returns false when the frame shouldn't be interpolated (a cut).
+bool BuildInterpolation(u64* matched_out, u64* total_out)
+{
+  s_interp_values = s_cur.values;
+  if (!s_have_prev)
+    return false;
+
+  // (address, count, signature) -> occurrences in the previous frame, in order.
+  std::unordered_map<u64, std::vector<u32>> prev_index;
+  prev_index.reserve(s_prev.events.size());
+  for (u32 i = 0; i < s_prev.events.size(); ++i)
+  {
+    const XFEvent& p = s_prev.events[i];
+    if (p.count == 0)
+      continue;
+    prev_index[Mix(Mix(p.address, p.count), p.signature)].push_back(i);
+  }
+
+  static const bool no_bp = std::getenv("COLO_INTERP_NOBP") != nullptr;
+  static const bool no_col = std::getenv("COLO_INTERP_NOCOL") != nullptr;
+  auto interesting = [](const XFEvent& e) {
+    if ((no_bp && IsBPColorEvent(e.address)) || (no_col && IsColorEvent(e) && !IsBPColorEvent(e.address)))
+      return false;
+    return e.count != 0 &&
+           (e.address < XFMEM_LIGHTS_END ||
+            (e.address >= XFMEM_SETPROJECTION && e.address < XFMEM_SETPROJECTION + 7) ||
+            IsBPColorEvent(e.address));
+  };
+
+  // Pass 1: strict signature.
+  std::vector<s32> partner(s_cur.events.size(), -1);
+  std::vector<bool> prev_used(s_prev.events.size(), false);
+  std::unordered_map<u64, u32> seen;
+  seen.reserve(prev_index.size());
+  u64 total = 0, matched = 0, moving = 0;
+  for (u32 k = 0; k < s_cur.events.size(); ++k)
+  {
+    const XFEvent& e = s_cur.events[k];
+    if (!interesting(e))
+      continue;
+    ++total;
+    const u64 key = Mix(Mix(e.address, e.count), e.signature);
+    const u32 occurrence = seen[key]++;
+    const auto it = prev_index.find(key);
+    if (it == prev_index.end())
+      continue;
+    const std::vector<u32>& list = it->second;
+    // Normally the same occurrence; but when something with the same signature appears or
+    // disappears (a blinking cursor from the same texture as a window frame), the order shifts,
+    // so take the closest unused candidate if the in-order one doesn't fit as well.
+    s32 pick = -1;
+    float pick_dist = std::numeric_limits<float>::infinity();
+    if (occurrence < list.size() && !prev_used[list[occurrence]])
+    {
+      pick = static_cast<s32>(list[occurrence]);
+      pick_dist = EventDistance(e, s_prev.events[pick]);
+    }
+    if (pick_dist > 0 && (e.address < XFMEM_LIGHTS_END || IsColorEvent(e)))
+    {
+      const u32 lo = occurrence > 32 ? occurrence - 32 : 0;
+      const u32 hi = std::min<u32>(static_cast<u32>(list.size()), occurrence + 33);
+      for (u32 c = lo; c < hi; ++c)
+      {
+        if (prev_used[list[c]])
+          continue;
+        const float dist = EventDistance(e, s_prev.events[list[c]]);
+        if (dist < pick_dist)
+        {
+          pick_dist = dist;
+          pick = static_cast<s32>(list[c]);
+        }
+      }
+    }
+    if (pick < 0)
+      continue;
+    partner[k] = pick;
+    prev_used[pick] = true;
+  }
+
+  // Pass 2: what's left, by the loose signature, in order.
+  std::unordered_map<u64, std::vector<u32>> loose_index;
+  for (u32 i = 0; i < s_prev.events.size(); ++i)
+  {
+    const XFEvent& p = s_prev.events[i];
+    if (!prev_used[i] && interesting(p))
+      loose_index[Mix(Mix(p.address, p.count), p.loose)].push_back(i);
+  }
+  std::unordered_map<u64, u32> loose_seen;
+  for (u32 k = 0; k < s_cur.events.size(); ++k)
+  {
+    const XFEvent& e = s_cur.events[k];
+    if (partner[k] >= 0 || !interesting(e))
+      continue;
+    const u64 key = Mix(Mix(e.address, e.count), e.loose);
+    const u32 occurrence = loose_seen[key]++;
+    const auto it = loose_index.find(key);
+    // Nearest unused candidate within a window around the expected occurrence, so a UI piece
+    // that appears or disappears doesn't shift every later pairing by one.
+    s32 pick = -1;
+    if (it != loose_index.end())
+    {
+      const std::vector<u32>& list = it->second;
+      const u32 lo = occurrence > 32 ? occurrence - 32 : 0;
+      const u32 hi = std::min<u32>(static_cast<u32>(list.size()), occurrence + 33);
+      float best = 0.0f;
+      for (u32 c = lo; c < hi; ++c)
+      {
+        if (prev_used[list[c]])
+          continue;
+        const float dist = EventDistance(e, s_prev.events[list[c]]);
+        if (pick < 0 || dist < best)
+        {
+          pick = static_cast<s32>(list[c]);
+          best = dist;
+        }
+      }
+    }
+    if (pick < 0)
+    {
+      if (s_debug_frame)
+        std::fprintf(stderr, "[interp] unmatched k=%u loose=%016llx addr=%03x n=%u sig=%016llx occ=%u\n", k, static_cast<unsigned long long>(e.loose), e.address,
+                     e.count, static_cast<unsigned long long>(e.signature), occurrence);
+      continue;
+    }
+    prev_used[pick] = true;
+    partner[k] = pick | (1 << 30);
+  }
+
+  for (u32 k = 0; k < s_cur.events.size(); ++k)
+  {
+    if (partner[k] < 0)
+      continue;
+    ++matched;
+    if (Blend(s_cur.events[k], s_prev.events[partner[k] & ~(1 << 30)], (partner[k] >> 30) != 0))
+      ++moving;
+  }
+  // Inline-vertex draws: by full signature and occurrence.
+  std::unordered_map<u64, std::vector<u32>> prev_draws;
+  for (u32 i = 0; i < s_prev.draws.size(); ++i)
+  {
+    const Draw& d = s_prev.draws[i];
+    if (d.pos_offset >= 0 || d.col_offset[0] >= 0 || d.col_offset[1] >= 0)
+      prev_draws[d.key].push_back(i);
+  }
+  // Pieces of one sprite batch can come in a different order each frame, so a draw with
+  // inline positions pairs with the nearest unused draw of the same kind; colour-only draws
+  // pair in order.
+  std::unordered_map<u64, u32> draw_seen;
+  std::vector<bool> prev_draw_used(s_prev.draws.size(), false);
+  for (Draw& d : s_cur.draws)
+  {
+    d.partner = -1;
+    static const bool no_vtx = std::getenv("COLO_INTERP_NOVTX") != nullptr;
+    if (no_vtx)
+      continue;
+    if (d.pos_offset < 0 && d.col_offset[0] < 0 && d.col_offset[1] < 0)
+      continue;
+    const u32 occurrence = draw_seen[d.key]++;
+    const auto it = prev_draws.find(d.key);
+    if (it == prev_draws.end())
+      continue;
+    if (d.pos_offset < 0 || it->second.size() > 256)
+    {
+      if (occurrence < it->second.size() && !prev_draw_used[it->second[occurrence]])
+      {
+        d.partner = static_cast<s32>(it->second[occurrence]);
+        prev_draw_used[d.partner] = true;
+      }
+      continue;
+    }
+    float best = std::numeric_limits<float>::infinity();
+    for (u32 cand : it->second)
+    {
+      if (prev_draw_used[cand])
+        continue;
+      const float m = DrawMove(d, s_prev.draws[cand]);
+      if (m < best)
+      {
+        best = m;
+        d.partner = static_cast<s32>(cand);
+        if (m == 0)
+          break;
+      }
+    }
+    if (d.partner >= 0)
+      prev_draw_used[d.partner] = true;
+  }
+
+  *matched_out = matched;
+  *total_out = total;
+  // A cut (new scene, camera switch) leaves most matrix loads without a partner.
+  if (total >= 8 && matched * 10 < total * 6)
+    return false;
+  return true;
+}
+
+class ReplayCallback final : public OpcodeDecoder::Callback
+{
+public:
+  void OnXF(u16 address, u8 count, const u8* data) override
+  {
+    if (m_event < s_cur.events.size())
+    {
+      const XFEvent& e = s_cur.events[m_event++];
+      if (e.address == address && e.count == count)
+      {
+        LoadXFReg(address, count, reinterpret_cast<const u8*>(&s_interp_values[e.offset]));
+        return;
+      }
+    }
+    LoadXFReg(address, count, data);
+  }
+  void OnCP(u8 command, u32 value) override
+  {
+    const u8 sub_command = command & CP_COMMAND_MASK;
+    auto& system = Core::System::GetInstance();
+    if (sub_command == MATINDEX_A)
+    {
+      VertexLoaderManager::g_needs_cp_xf_consistency_check = true;
+      system.GetXFStateManager().SetTexMatrixChangedA(value);
+    }
+    else if (sub_command == MATINDEX_B)
+    {
+      VertexLoaderManager::g_needs_cp_xf_consistency_check = true;
+      system.GetXFStateManager().SetTexMatrixChangedB(value);
+    }
+    else if (sub_command == VCD_LO || sub_command == VCD_HI)
+    {
+      VertexLoaderManager::g_main_vat_dirty = BitSet8::AllTrue(CP_NUM_VAT_REG);
+      VertexLoaderManager::g_bases_dirty = true;
+      VertexLoaderManager::g_needs_cp_xf_consistency_check = true;
+    }
+    else if (sub_command == CP_VAT_REG_A || sub_command == CP_VAT_REG_B ||
+             sub_command == CP_VAT_REG_C)
+    {
+      VertexLoaderManager::g_main_vat_dirty[command & CP_VAT_MASK] = true;
+      VertexLoaderManager::g_needs_cp_xf_consistency_check = true;
+    }
+    else if (sub_command == ARRAY_BASE)
+    {
+      VertexLoaderManager::g_bases_dirty = true;
+    }
+    g_main_cp_state.LoadCPReg(command, value);
+  }
+  void OnBP(u8 command, u32 value) override
+  {
+    if (command >= BP_TEV_COLOR_FIRST && command <= BP_TEV_COLOR_LAST &&
+        m_event < s_cur.events.size())
+    {
+      const XFEvent& e = s_cur.events[m_event++];
+      if (e.address == BP_EVENT_BASE + command)
+        value = Common::swap32(s_interp_values[e.offset]);
+    }
+    LoadBPReg(command, value, 0);
+  }
+  void OnIndexedLoad(CPArray, u32, u16 address, u8 size) override
+  {
+    if (m_event >= s_cur.events.size())
+      return;
+    const XFEvent& e = s_cur.events[m_event++];
+    if (e.count != 0 && e.address == address && e.count == size)
+      LoadXFReg(address, size, reinterpret_cast<const u8*>(&s_interp_values[e.offset]));
+  }
+  void OnPrimitiveCommand(OpcodeDecoder::Primitive primitive, u8 vat, u32, u16 num_vertices,
+                          const u8* vertex_data) override
+  {
+    const u8* data = vertex_data;
+    if (m_draw < s_cur.draws.size())
+    {
+      const Draw& d = s_cur.draws[m_draw++];
+      if (d.partner >= 0)
+        data = BlendVertices(d, s_prev.draws[d.partner], vertex_data);
+    }
+    VertexLoaderManager::RunVertices<false>(vat, primitive, num_vertices, data);
+  }
+  void OnDisplayList(u32, u32) override {}  // display lists were recorded inline
+  void OnNop(u32) override {}
+  void OnUnknown(u8, const u8*) override {}
+  void OnCommand(const u8*, u32) override {}
+  CPState& GetCPState() override { return g_main_cp_state; }
+  u32 GetVertexSize(u8 vat) override
+  {
+    return VertexLoaderManager::RefreshLoader<false>(vat)->m_vertex_size;
+  }
+
+private:
+  size_t m_event = 0;
+  size_t m_draw = 0;
+  std::vector<u8> m_scratch;
+
+  static void WriteComponent(u8* p, u8 format, float v)
+  {
+    switch (format)
+    {
+    case 0: p[0] = u8(std::clamp(std::lround(v), 0L, 255L)); break;
+    case 1: p[0] = u8(s8(std::clamp(std::lround(v), -128L, 127L))); break;
+    case 2:
+    {
+      const u16 x = u16(std::clamp(std::lround(v), 0L, 65535L));
+      p[0] = u8(x >> 8);
+      p[1] = u8(x);
+      break;
+    }
+    case 3:
+    {
+      const u16 x = u16(s16(std::clamp(std::lround(v), -32768L, 32767L)));
+      p[0] = u8(x >> 8);
+      p[1] = u8(x);
+      break;
+    }
+    default:
+    {
+      const u32 x = std::bit_cast<u32>(v);
+      p[0] = u8(x >> 24);
+      p[1] = u8(x >> 16);
+      p[2] = u8(x >> 8);
+      p[3] = u8(x);
+      break;
+    }
+    }
+  }
+
+  const u8* BlendVertices(const Draw& d, const Draw& p, const u8* cur)
+  {
+    if (p.data_offset + size_t(p.count) * p.vertex_size > s_prev.commands.size() ||
+        p.vertex_size != d.vertex_size || p.count != d.count)
+      return cur;
+    const u8* prev = &s_prev.commands[p.data_offset];
+    const size_t bytes = size_t(d.count) * d.vertex_size;
+    if (std::memcmp(prev, cur, bytes) == 0)
+      return cur;
+    m_scratch.assign(cur, cur + bytes);
+    u8* out = m_scratch.data();
+    const u32 stride = d.vertex_size;
+
+    if (d.pos_offset >= 0)
+    {
+      // Same draw, moved by more than twice its own size: a different particle, not motion.
+      const u32 cs = ComponentSize(d.pos_format);
+      float lo[3] = {1e30f, 1e30f, 1e30f}, hi[3] = {-1e30f, -1e30f, -1e30f}, max_move = 0;
+      bool finite = true;
+      for (u32 v = 0; v < d.count; ++v)
+      {
+        float move = 0;
+        for (u32 c = 0; c < d.pos_components; ++c)
+        {
+          const float x = ReadComponent(prev + v * stride + d.pos_offset + c * cs, d.pos_format);
+          const float y = ReadComponent(cur + v * stride + d.pos_offset + c * cs, d.pos_format);
+          finite = finite && std::isfinite(x) && std::isfinite(y);
+          lo[c] = std::min(lo[c], y);
+          hi[c] = std::max(hi[c], y);
+          move = std::max(move, std::fabs(y - x));
+        }
+        max_move = std::max(max_move, move);
+      }
+      float extent = 0;
+      for (u32 c = 0; c < d.pos_components; ++c)
+        extent = std::max(extent, hi[c] - lo[c]);
+      if (finite && max_move <= 2.0f * extent + 1e-3f)
+      {
+        for (u32 v = 0; v < d.count; ++v)
+        {
+          for (u32 c = 0; c < d.pos_components; ++c)
+          {
+            const u32 at = v * stride + d.pos_offset + c * cs;
+            const float x = ReadComponent(prev + at, d.pos_format);
+            const float y = ReadComponent(cur + at, d.pos_format);
+            if (x != y)
+              WriteComponent(out + at, d.pos_format, x + (y - x) * s_t);
+          }
+        }
+      }
+    }
+    for (int i = 0; i < 2; ++i)
+    {
+      if (d.col_offset[i] < 0)
+        continue;
+      for (u32 v = 0; v < d.count; ++v)
+      {
+        for (u32 c = 0; c < d.col_bytes[i]; ++c)
+        {
+          const u32 at = v * stride + d.col_offset[i] + c;
+          const float x = prev[at], y = cur[at];
+          out[at] = u8(std::clamp(std::lround(x + (y - x) * s_t), 0L, 255L));
+        }
+      }
+    }
+    return out;
+  }
+};
+
+void UpdateHook()
+{
+  g_hook = g_recording || s_frame_end_pending;
+}
+
+void Replay()
+{
+  // In-between frames needed before this one: it will be on screen for about as many fields
+  // as the last one, and each field gets PresentsPerField() presents. Frames the game holds
+  // for more than one field (its own 30 fps scripted scenes) are shown as they are: filling
+  // a 33 ms gap made objects flicker and pop in.
+  if (s_fields_per_frame > 1)
+    return;
+  const int count = std::clamp(s_fields_per_frame * s_presents_per_field.load() - 1, 0, 3);
+  if (count == 0)
+    return;
+
+  const auto start = std::chrono::steady_clock::now();
+  std::vector<std::shared_ptr<TCacheEntry>> results;
+  SaveGpuState(s_live_state);
+  for (int k = 1; k <= count; ++k)
+  {
+    s_t = s_t_override >= 0 ? s_t_override : static_cast<float>(k) / (count + 1);
+    u64 matched = 0, total = 0;
+    const bool ok = BuildInterpolation(&matched, &total);
+    if (k == 1)
+    {
+      s_stat_events += total;
+      s_stat_matched += matched;
+    }
+    if (!ok)
+    {
+      ++s_stat_cuts;
+      results.clear();
+      break;
+    }
+
+    LoadGpuState(s_start_state);
+    s_tlut_read = 0;
+    s_replay_result.reset();
+    g_replaying = true;
+    ReplayCallback callback;
+    OpcodeDecoder::Run(s_cur.commands.data(), static_cast<u32>(s_cur.commands.size()), callback);
+    g_vertex_manager->Flush();
+    g_replaying = false;
+    if (!s_replay_result)
+    {
+      results.clear();
+      break;
+    }
+    results.push_back(std::move(s_replay_result));
+  }
+  LoadGpuState(s_live_state);
+
+  if (!results.empty())
+  {
+    Ready& slot = s_ready[s_ready_seq++ % s_ready.size()];
+    slot.addr = s_pending_xfb_addr;
+    slot.entries = std::move(results);
+    ++s_stat_replayed;
+  }
+  s_stat_ms += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start)
+                   .count();
+}
+
+void EndFrame()
+{
+  s_frame_end_pending = false;
+  const bool want = s_want_enabled.load(std::memory_order_relaxed);
+
+  if (!want)
+  {
+    Reset();
+    return;
+  }
+
+  // Whatever was waiting for this buffer is older than the frame just drawn into it.
+  DropReady(s_pending_xfb_addr);
+  if (g_recording && s_have_start)
+  {
+    static int debug_frames = 1;
+    s_debug_frame = s_log && s_stat_frames >= 1700 && debug_frames > 0;
+    if (s_debug_frame)
+      --debug_frames;
+    Replay();
+    if (s_log && ++s_stat_frames % 120 == 0)
+    {
+      std::fprintf(stderr,
+                   "[interp] frames=%u replayed=%u cuts=%u matched=%.1f%% avg=%.2f ms cmds=%zu KB fields/frame=%d presents/field=%d\n",
+                   s_stat_frames, s_stat_replayed, s_stat_cuts,
+                   s_stat_events ? 100.0 * s_stat_matched / s_stat_events : 0.0,
+                   s_stat_replayed ? s_stat_ms / s_stat_replayed : 0.0, s_cur.commands.size() / 1024,
+                   s_fields_per_frame, s_presents_per_field.load());
+      s_stat_replayed = s_stat_cuts = 0;
+      s_stat_events = s_stat_matched = 0;
+      s_stat_ms = 0;
+    }
+  }
+
+  // The live state now is where the next frame starts.
+  SaveGpuState(s_start_state);
+  s_have_start = true;
+  if (g_recording)
+  {
+    std::swap(s_prev, s_cur);
+    s_have_prev = true;
+  }
+  s_cur.Clear();
+  g_recording = true;
+  UpdateHook();
+}
+}  // namespace
+
+void SetEnabled(bool enabled)
+{
+  s_want_enabled.store(enabled, std::memory_order_relaxed);
+  static bool env_read = false;
+  if (!env_read)
+  {
+    env_read = true;
+    if (const char* t = std::getenv("COLO_INTERP_T"))
+      s_t_override = static_cast<float>(std::atof(t));
+    s_log = std::getenv("COLO_INTERP_LOG") != nullptr;
+  }
+}
+
+bool IsEnabled()
+{
+  return s_want_enabled.load(std::memory_order_relaxed);
+}
+
+void OnCommand(const u8* data, u32 size)
+{
+  if (g_recording && static_cast<OpcodeDecoder::Opcode>(data[0]) != OpcodeDecoder::Opcode::GX_CMD_CALL_DL)
+    s_cur.commands.insert(s_cur.commands.end(), data, data + size);
+  if (s_frame_end_pending)
+    EndFrame();
+}
+
+void RecordXF(u16 address, u8 count, const u8* big_endian_data)
+{
+  XFEvent e{address, count, static_cast<u32>(s_cur.values.size()), 0, 0};
+  if (big_endian_data == nullptr)
+  {
+    e.count = 0;
+  }
+  else
+  {
+    const size_t at = s_cur.values.size();
+    s_cur.values.resize(at + count);
+    std::memcpy(&s_cur.values[at], big_endian_data, count * sizeof(u32));
+  }
+  s_cur.events.push_back(e);
+}
+
+void RecordDraw(u8 cmd_byte, u16 num_vertices)
+{
+  const u8 vat = cmd_byte & 7;
+  const TVtxDesc& desc = g_main_cp_state.vtx_desc;
+  const VAT& attr = g_main_cp_state.vtx_attr[vat];
+  u64 loose = Mix(cmd_byte, desc.low.Hex);
+  loose = Mix(loose, desc.high.Hex);
+  loose = Mix(Mix(Mix(loose, attr.g0.Hex), attr.g1.Hex), attr.g2.Hex);
+  // Vertex buffers the CPU rewrites every frame are often double-buffered, particle batches
+  // change size, and render-to-texture targets can alternate between two addresses, so those
+  // only go into the strict signature.
+  u64 sig = Mix(loose, num_vertices);
+  sig = Mix(sig, g_main_cp_state.array_bases[CPArray::Position]);
+  sig = Mix(sig, bpmem.tex.GetUnit(0).texImage3.image_base);
+  for (size_t i = s_cur.unsigned_from; i < s_cur.events.size(); ++i)
+  {
+    s_cur.events[i].signature = sig;
+    s_cur.events[i].loose = loose;
+  }
+  s_cur.unsigned_from = s_cur.events.size();
+
+  // Layout of inline positions/colours (offsets within one vertex).
+  Draw d{};
+  d.key = sig;
+  d.data_offset = static_cast<u32>(s_cur.commands.size() + 3);  // after opcode + count
+  d.count = num_vertices;
+  d.vertex_size = static_cast<u16>(VertexLoaderBase::GetVertexSize(desc, attr));
+  u32 offset = std::popcount(desc.low.Hex & 0x1FF);
+  if (desc.low.Position == VertexComponentFormat::Direct)
+  {
+    d.pos_offset = static_cast<s16>(offset);
+    d.pos_format = std::min<u8>(static_cast<u8>(attr.g0.PosFormat.Value()), 4);
+    d.pos_components = attr.g0.PosElements == CoordComponentCount::XYZ ? 3 : 2;
+  }
+  offset += VertexLoader_Position::GetSize(desc.low.Position, attr.g0.PosFormat, attr.g0.PosElements);
+  offset += VertexLoader_Normal::GetSize(desc.low.Normal, attr.g0.NormalFormat,
+                                         attr.g0.NormalElements, attr.g0.NormalIndex3);
+  for (u32 i = 0; i < 2; ++i)
+  {
+    const ColorFormat cf = attr.GetColorFormat(i);
+    if (desc.low.Color[i] == VertexComponentFormat::Direct &&
+        (cf == ColorFormat::RGB888 || cf == ColorFormat::RGB888x || cf == ColorFormat::RGBA8888))
+    {
+      d.col_offset[i] = static_cast<s16>(offset);
+      d.col_bytes[i] = cf == ColorFormat::RGBA8888 ? 4 : 3;
+    }
+    offset += VertexLoader_Color::GetSize(desc.low.Color[i], cf);
+  }
+  s_cur.draws.push_back(d);
+}
+
+void RecordTlut(const u8* data, u32 size)
+{
+  s_cur.tluts.insert(s_cur.tluts.end(), data, data + size);
+}
+
+bool ReplayTlut(u8* dest, u32 size)
+{
+  if (s_tlut_read + size > s_cur.tluts.size())
+    return false;
+  std::memcpy(dest, &s_cur.tluts[s_tlut_read], size);
+  s_tlut_read += size;
+  return true;
+}
+
+void RecordBP(u8 reg, u32 value)
+{
+  if (reg < BP_TEV_COLOR_FIRST || reg > BP_TEV_COLOR_LAST)
+    return;
+  const u32 be = Common::swap32(value);
+  RecordXF(BP_EVENT_BASE + reg, 1, reinterpret_cast<const u8*>(&be));
+}
+
+void OnLiveXFBCopy(u32 dest_addr)
+{
+  static const bool env_init = [] {
+    if (const char* e = std::getenv("COLO_INTERP"))
+      SetEnabled(e[0] == '1');
+    return true;
+  }();
+  (void)env_init;
+  if (!g_recording && !s_want_enabled.load(std::memory_order_relaxed))
+    return;
+  s_frame_end_pending = true;
+  s_pending_xfb_addr = dest_addr;
+  UpdateHook();
+}
+
+void OnReplayXFBCopy(std::shared_ptr<TCacheEntry> entry)
+{
+  s_replay_result = std::move(entry);
+}
+
+std::vector<std::shared_ptr<TCacheEntry>> TakeInterpolatedFrames(u32 xfb_addr)
+{
+  for (Ready& r : s_ready)
+  {
+    if (!r.entries.empty() && r.addr == xfb_addr)
+      return std::move(r.entries);
+  }
+  return {};
+}
+
+void SetPresentsPerField(int presents)
+{
+  s_presents_per_field.store(std::clamp(presents, 1, 4), std::memory_order_relaxed);
+}
+
+int PresentsPerField()
+{
+  return s_presents_per_field.load(std::memory_order_relaxed);
+}
+
+void NoteFieldsPerFrame(int fields)
+{
+  if (fields >= 1)
+    s_fields_per_frame = std::min(fields, 4);
+}
+
+void Reset()
+{
+  g_recording = false;
+  g_replaying = false;
+  s_frame_end_pending = false;
+  s_have_start = false;
+  s_have_prev = false;
+  s_cur.Clear();
+  s_prev.Clear();
+  for (Ready& r : s_ready)
+    r.entries.clear();
+  s_replay_result.reset();
+  UpdateHook();
+}
+}  // namespace FrameInterpolation
diff --git a/Source/Core/VideoCommon/FrameInterpolation.h b/Source/Core/VideoCommon/FrameInterpolation.h
new file mode 100644
index 0000000..18d9d13
--- /dev/null
+++ b/Source/Core/VideoCommon/FrameInterpolation.h
@@ -0,0 +1,65 @@
+// Copyright 2026 Colosseum Native
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Geometric frame interpolation (Colosseum Native).
+//
+// Games whose logic is tied to the 60 Hz video interface can't simply run faster. Instead, every
+// frame's GPU command stream is recorded together with the GPU state it started from. When frame
+// N ends (its XFB copy), the frame is drawn a second time from that recorded stream with every
+// transform matrix, light and projection blended halfway between frame N-1 and frame N. The
+// result is a real, fully rendered in-between frame (no optical-flow guesswork), shown half a
+// video field before frame N, which doubles the presented frame rate.
+//
+// Matrix loads are matched between frames by address, by a signature of the draw that follows
+// them, and by occurrence; anything that can't be matched (new objects, CPU-animated vertices)
+// is drawn as in frame N. Camera cuts are detected and skip interpolation.
+//
+// Everything here runs on the GPU thread, except SetEnabled.
+
+#pragma once
+
+#include <memory>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+
+struct TCacheEntry;
+
+namespace FrameInterpolation
+{
+// Any thread. Takes effect at the next frame boundary.
+void SetEnabled(bool enabled);
+bool IsEnabled();
+
+// GPU thread fast-path flags.
+extern bool g_recording;   // recording the current frame's commands
+extern bool g_hook;        // OnCommand must be called (recording, or a frame just ended)
+extern bool g_replaying;   // drawing the interpolated frame
+
+// Hooks from the live command processor.
+void OnCommand(const u8* data, u32 size);
+void RecordXF(u16 address, u8 count, const u8* big_endian_data);
+void RecordDraw(u8 cmd_byte, u16 num_vertices);
+void RecordBP(u8 reg, u32 value);
+void OnLiveXFBCopy(u32 dest_addr);
+// Palette (TLUT) loads: recorded live, replayed from the recording instead of guest RAM.
+void RecordTlut(const u8* data, u32 size);
+bool ReplayTlut(u8* dest, u32 size);
+
+// Result of the replayed XFB copy.
+void OnReplayXFBCopy(std::shared_ptr<TCacheEntry> entry);
+
+// Presenter: the in-between frames (in order) that go before the XFB at xfb_addr.
+std::vector<std::shared_ptr<TCacheEntry>> TakeInterpolatedFrames(u32 xfb_addr);
+
+// Presents per video field: 1 = 60 fps output, 2 = 120 fps output. Any thread.
+void SetPresentsPerField(int presents);
+int PresentsPerField();
+
+// Presenter, on each new game frame: how many fields the previous one lasted (2 when the
+// game runs at 30 fps).
+void NoteFieldsPerFrame(int fields);
+
+// Drop all recorded state (savestate load, backend change).
+void Reset();
+}  // namespace FrameInterpolation
